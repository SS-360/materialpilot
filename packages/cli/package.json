{
  "name": "@materialpilot/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "materialpilot": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@materialpilot/domain": "workspace:*",
    "@materialpilot/bridge-protocol": "workspace:*",
    "@materialpilot/node-catalog": "workspace:*",
    "@materialpilot/ptex": "workspace:*",
    "@materialpilot/security": "workspace:*",
    "@materialpilot/validator": "workspace:*",
    "commander": "^15.0.0"
  }
}
